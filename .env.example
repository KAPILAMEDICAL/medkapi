# ---------------------------------------------------------------------------
# Kapila Medical Agencies — environment configuration template
# Copy to .env for local development: cp .env.example .env
# ---------------------------------------------------------------------------

# PostgreSQL connection string
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/kapila_medical"

# Secret used to sign session JWTs. Generate with: openssl rand -base64 48
AUTH_SECRET="replace-with-a-long-random-string-in-production"

# Seed/bootstrap credentials for the first Super Admin account (used only
# by `npm run db:seed`; change immediately after first login in production).
SUPER_ADMIN_MOBILE="9900000000"
SUPER_ADMIN_PASSWORD="ChangeMe@123"

# --- SMS / OTP provider -----------------------------------------------------
# PRODUCTION INTEGRATION POINT: this platform ships with a "console" SMS
# provider (src/lib/providers/sms.ts) that logs OTPs to the server console
# instead of sending real SMS — safe for development, NOT for production.
# Set SMS_PROVIDER=msg91|twilio once real credentials are available and
# implement the corresponding class in src/lib/providers/sms.ts.
SMS_PROVIDER="console"
SMS_API_KEY=""
SMS_SENDER_ID="KAPMED"

# --- File storage ------------------------------------------------------------
# PRODUCTION INTEGRATION POINT: ships with a local-disk storage provider
# (src/lib/providers/storage.ts) for development. Set STORAGE_PROVIDER=s3
# and fill the credentials below for any S3-compatible bucket in production.
STORAGE_PROVIDER="local"
STORAGE_LOCAL_DIR="./uploads"
S3_ENDPOINT=""
S3_BUCKET=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_REGION=""

# --- OCR provider --------------------------------------------------------
# Ships with a real, local, no-API-key OCR engine (tesseract.js) suitable
# for development and small-scale production use. For higher accuracy at
# scale, set OCR_PROVIDER=google-vision|textract and supply credentials.
OCR_PROVIDER="tesseract"
OCR_API_KEY=""

# --- Maps provider (tour routing / distance display) ------------------------
# PRODUCTION INTEGRATION POINT: no map is bundled by default (avoids
# shipping a paid API key). Set MAPS_PROVIDER=google|mapbox and a key to
# enable map rendering in Today's Tour.
MAPS_PROVIDER="none"
MAPS_API_KEY=""

NODE_ENV="development"
