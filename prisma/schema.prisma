// Kapila Medical Agencies — Digital Distribution Platform
// Database schema (PostgreSQL via Prisma)
//
// See docs/DATABASE_SCHEMA.md for the entity-relationship narrative and
// the reasoning behind each design choice (soft delete, ledger design,
// price-tier visibility, etc).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// ENUMS
// ---------------------------------------------------------------------------

enum Role {
  SUPER_ADMIN
  ADMIN
  SALES_MANAGER
  SALES_BOY
  CUSTOMER
  ACCOUNTS
}

enum CustomerStatus {
  PENDING_APPROVAL
  APPROVED
  DISABLED
  REJECTED
}

enum CustomerType {
  PHARMACY
  HOSPITAL
  CLINIC
  INSTITUTION
  OTHER
}

// Controls which price fields a customer (or the sales app on their behalf)
// is allowed to see. Trade pricing must never leak to an unauthorized viewer.
enum PriceVisibility {
  MRP_ONLY
  MRP_AND_PTR
  ALL_PRICES
}

enum OrderStatus {
  DRAFT
  BOOKED
  CONFIRMED
  PROCESSING
  PACKED
  DISPATCHED
  DELIVERED
  CANCELLED
  RETURNED
}

enum OrderSource {
  CUSTOMER_APP
  SALES_APP
  ADMIN
}

enum PaymentMode {
  CASH
  UPI
  BANK_TRANSFER
  CHEQUE
  OTHER
}

enum PaymentStatus {
  PENDING
  RECEIVED
  PARTIALLY_RECEIVED
  VERIFIED
  REJECTED
  CLEARED
  BOUNCED
}

enum ExpenseStatus {
  PENDING
  CORRECTION_REQUESTED
  APPROVED
  REJECTED
  REIMBURSED
}

/// Direction of a month-end advance-vs-expense settlement (§13).
enum SettlementDirection {
  AMOUNT_TO_RETURN // salesman is still holding unspent advance
  AMOUNT_TO_REIMBURSE // approved expenses exceeded advance given
  SETTLED // advance exactly matched approved expenses
}

enum VisitStatus {
  PLANNED
  IN_PROGRESS
  COMPLETED
  SKIPPED
}

enum LedgerEntryType {
  OPENING_BALANCE
  INVOICE
  PAYMENT
  CREDIT_NOTE
  DEBIT_NOTE
  ADJUSTMENT
}

enum OtpPurpose {
  CUSTOMER_LOGIN
  SALES_LOGIN
  ADMIN_LOGIN_2FA
  CUSTOMER_REGISTRATION
}

// ---------------------------------------------------------------------------
// AUTH & IDENTITY
// ---------------------------------------------------------------------------

/// Central identity for every human who can log in, regardless of role.
/// Role-specific data lives in Customer / Salesman; admin-type roles
/// (SUPER_ADMIN, ADMIN, SALES_MANAGER, ACCOUNTS) use this table directly.
model User {
  id           String   @id @default(cuid())
  role         Role
  mobile       String?  @unique
  email        String?  @unique
  name         String?
  passwordHash String? // set only for admin-type roles that use a password
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  customer Customer?
  salesman Salesman?

  sessions               Session[]
  notifications          Notification[]
  auditLogs              AuditLog[]          @relation("AuditActor")
  ordersCreated          Order[]             @relation("OrderCreatedBy")
  paymentsRecorded       Payment[]           @relation("PaymentRecordedBy")
  paymentsVerified       Payment[]           @relation("PaymentVerifiedBy")
  expensesReviewed       Expense[]           @relation("ExpenseReviewedBy")
  expenseAdvancesGiven   ExpenseAdvance[]    @relation("AdvanceGivenBy")
  expenseSettlementsMade ExpenseSettlement[] @relation("SettlementSettledBy")
  toursCreated           TourSchedule[]      @relation("TourCreatedBy")
  settingsUpdated        Setting[]           @relation("SettingUpdatedBy")
  managedSalesmen        Salesman[]          @relation("SalesmanManager")

  @@index([role])
}

/// Short-lived OTP challenge. Codes are stored as salted hashes, never
/// plaintext, and are single-use + time-boxed + rate-limited.
model OtpVerification {
  id          String     @id @default(cuid())
  mobile      String
  purpose     OtpPurpose
  codeHash    String
  attempts    Int        @default(0)
  maxAttempts Int        @default(5)
  expiresAt   DateTime
  consumedAt  DateTime?
  requestIp   String?
  createdAt   DateTime   @default(now())

  @@index([mobile, purpose])
}

/// One row per logged-in device/session. Enables "logout from all devices"
/// and session/device tracking for the audit trail.
model Session {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash  String    @unique
  userAgent  String?
  ip         String?
  createdAt  DateTime  @default(now())
  lastSeenAt DateTime  @default(now())
  expiresAt  DateTime
  revokedAt  DateTime?

  @@index([userId])
}

// ---------------------------------------------------------------------------
// CUSTOMERS
// ---------------------------------------------------------------------------

model Customer {
  id                 String          @id @default(cuid())
  userId             String          @unique
  user               User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  firmName           String
  ownerName          String
  mobile             String          @unique
  whatsapp           String?
  email              String?
  address            String
  area               String?
  city               String
  pincode            String
  gstNumber          String?
  drugLicenceNo      String?
  customerType       CustomerType    @default(PHARMACY)
  status             CustomerStatus  @default(PENDING_APPROVAL)
  priceVisibility    PriceVisibility @default(MRP_ONLY)
  creditLimit        Decimal?        @db.Decimal(12, 2)
  assignedSalesmanId String?
  assignedSalesman   Salesman?       @relation(fields: [assignedSalesmanId], references: [id])
  approvedByUserId   String?
  approvedAt         DateTime?
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt
  deletedAt          DateTime?

  orders        Order[]
  payments      Payment[]
  ledgerEntries LedgerEntry[]
  visits        Visit[]
  tourStops     TourStop[]
  notes         CustomerNote[]

  @@index([status])
  @@index([assignedSalesmanId])
  @@index([firmName])
}

model CustomerNote {
  id           String   @id @default(cuid())
  customerId   String
  customer     Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  authorUserId String
  note         String
  createdAt    DateTime @default(now())
}

// ---------------------------------------------------------------------------
// SALES TEAM
// ---------------------------------------------------------------------------

model Salesman {
  id                      String   @id @default(cuid())
  userId                  String   @unique
  user                    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  employeeCode            String   @unique
  name                    String
  mobile                  String   @unique
  email                   String?
  territory               String?
  monthlySalesTarget      Decimal  @default(0) @db.Decimal(12, 2)
  monthlyCollectionTarget Decimal  @default(0) @db.Decimal(12, 2)
  // Overrides the global `expense.monthlyLimitDefault` Setting for this
  // salesman when set (Master Prompt §8 "Admin can configure expense limits").
  monthlyExpenseLimit     Decimal? @db.Decimal(12, 2)
  managerUserId           String?
  manager                 User?    @relation("SalesmanManager", fields: [managerUserId], references: [id])
  isActive                Boolean  @default(true)
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  customers          Customer[]
  ordersBooked       Order[]             @relation("OrderSalesman")
  paymentsMade       Payment[]           @relation("PaymentSalesman")
  expenses           Expense[]
  expenseAdvances    ExpenseAdvance[]
  expenseSettlements ExpenseSettlement[]
  tourSchedules      TourSchedule[]
  visits             Visit[]

  @@index([managerUserId])
}

// ---------------------------------------------------------------------------
// CATALOG: COMPANIES / DIVISIONS / CATEGORIES / PRODUCTS
// ---------------------------------------------------------------------------

model Company {
  id          String   @id @default(cuid())
  name        String   @unique
  slug        String   @unique
  logoUrl     String?
  description String?
  contactInfo String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  divisions Division[]
  products  Product[]
  offers    Offer[]

  @@index([name])
}

model Division {
  id        String   @id @default(cuid())
  companyId String
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  name      String
  createdAt DateTime @default(now())

  products Product[]

  @@unique([companyId, name])
}

model Category {
  id       String     @id @default(cuid())
  name     String     @unique
  parentId String?
  parent   Category?  @relation("CategoryTree", fields: [parentId], references: [id])
  children Category[] @relation("CategoryTree")

  products Product[]
}

model Product {
  id          String    @id @default(cuid())
  name        String
  slug        String    @unique
  companyId   String
  company     Company   @relation(fields: [companyId], references: [id])
  divisionId  String?
  division    Division? @relation(fields: [divisionId], references: [id])
  categoryId  String?
  category    Category? @relation(fields: [categoryId], references: [id])
  composition String?
  packSize    String?
  sku         String?   @unique
  productCode String?   @unique
  hsnCode     String?

  mrp        Decimal  @db.Decimal(10, 2)
  ptr        Decimal? @db.Decimal(10, 2) // price to retailer
  pts        Decimal? @db.Decimal(10, 2) // price to stockist
  gstPercent Decimal  @default(12) @db.Decimal(4, 2)

  stockQty    Int @default(0)
  minOrderQty Int @default(1)

  imageUrl     String?
  isFastMoving Boolean @default(false)
  isFeatured   Boolean @default(false)
  isActive     Boolean @default(true)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  images     ProductImage[]
  orderItems OrderItem[]
  offers     Offer[]

  @@index([name])
  @@index([companyId])
  @@index([isFastMoving])
  @@index([isFeatured])
  @@index([createdAt])
}

model ProductImage {
  id        String  @id @default(cuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  url       String
  sortOrder Int     @default(0)
}

// ---------------------------------------------------------------------------
// OFFERS
// ---------------------------------------------------------------------------

model Offer {
  id                 String   @id @default(cuid())
  title              String
  description        String?
  posterUrl          String?
  schemeText         String? // e.g. "Buy 5 Get 1 Free", "10 + 2"
  productId          String?
  product            Product? @relation(fields: [productId], references: [id])
  companyId          String?
  company            Company? @relation(fields: [companyId], references: [id])
  minQty             Int?
  startDate          DateTime
  endDate            DateTime
  visibleToCustomers Boolean  @default(true)
  visibleToSales     Boolean  @default(true)
  isActive           Boolean  @default(true)
  createdAt          DateTime @default(now())

  @@index([isActive, startDate, endDate])
}

// ---------------------------------------------------------------------------
// ORDERS
// ---------------------------------------------------------------------------

model Order {
  id              String      @id @default(cuid())
  orderNumber     String      @unique
  customerId      String
  customer        Customer    @relation(fields: [customerId], references: [id])
  createdByUserId String
  createdBy       User        @relation("OrderCreatedBy", fields: [createdByUserId], references: [id])
  salesmanId      String?
  salesman        Salesman?   @relation("OrderSalesman", fields: [salesmanId], references: [id])
  source          OrderSource
  status          OrderStatus @default(BOOKED)

  subtotal   Decimal @default(0) @db.Decimal(12, 2)
  taxTotal   Decimal @default(0) @db.Decimal(12, 2)
  grandTotal Decimal @default(0) @db.Decimal(12, 2)
  notes      String?

  bookedAt     DateTime  @default(now())
  confirmedAt  DateTime?
  dispatchedAt DateTime?
  deliveredAt  DateTime?
  cancelledAt  DateTime?
  cancelReason String?

  items         OrderItem[]
  ledgerEntries LedgerEntry[]
  visit         Visit?

  @@index([customerId])
  @@index([status])
  @@index([bookedAt])
}

model OrderItem {
  id             String  @id @default(cuid())
  orderId        String
  order          Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId      String
  product        Product @relation(fields: [productId], references: [id])
  quantity       Int
  unitPrice      Decimal @db.Decimal(10, 2)
  gstPercent     Decimal @db.Decimal(4, 2)
  discountAmount Decimal @default(0) @db.Decimal(10, 2)
  lineTotal      Decimal @db.Decimal(12, 2)
  offerNote      String?

  @@index([orderId])
  @@index([productId])
}

// ---------------------------------------------------------------------------
// PAYMENTS & LEDGER
// ---------------------------------------------------------------------------

model Payment {
  id               String    @id @default(cuid())
  paymentNumber    String    @unique
  customerId       String
  customer         Customer  @relation(fields: [customerId], references: [id])
  salesmanId       String?
  salesman         Salesman? @relation("PaymentSalesman", fields: [salesmanId], references: [id])
  recordedByUserId String
  recordedBy       User      @relation("PaymentRecordedBy", fields: [recordedByUserId], references: [id])

  amount          Decimal       @db.Decimal(12, 2)
  mode            PaymentMode
  status          PaymentStatus @default(RECEIVED)
  referenceNumber String?
  chequeNumber    String?
  chequeBank      String?
  chequeDate      DateTime?
  remarks         String?
  receiptImageUrl String?

  paidAt           DateTime  @default(now())
  verifiedByUserId String?
  verifiedBy       User?     @relation("PaymentVerifiedBy", fields: [verifiedByUserId], references: [id])
  verifiedAt       DateTime?

  ledgerEntries LedgerEntry[]

  @@index([customerId])
  @@index([status])
  @@index([paidAt])
}

/// Append-only running account statement per customer. Every invoice and
/// payment writes exactly one row here; balanceAfter is computed at write
/// time so statements render without re-summing history on every read.
model LedgerEntry {
  id                 String          @id @default(cuid())
  customerId         String
  customer           Customer        @relation(fields: [customerId], references: [id])
  entryType          LedgerEntryType
  referenceOrderId   String?
  referenceOrder     Order?          @relation(fields: [referenceOrderId], references: [id])
  referencePaymentId String?
  referencePayment   Payment?        @relation(fields: [referencePaymentId], references: [id])
  description        String
  debit              Decimal         @default(0) @db.Decimal(12, 2)
  credit             Decimal         @default(0) @db.Decimal(12, 2)
  balanceAfter       Decimal         @db.Decimal(12, 2)
  entryDate          DateTime        @default(now())

  @@index([customerId, entryDate])
}

// ---------------------------------------------------------------------------
// EXPENDITURE MANAGEMENT (bill photo + manual entry, OCR, GPS, approval,
// advances & settlement) — see docs/DATABASE_SCHEMA.md "Expenditure module".
// ---------------------------------------------------------------------------

/// Admin-configurable expense category (Master Prompt §5). `code` is a
/// stable, never-reused slug referenced by the OCR keyword heuristics and
/// by report grouping; `name` is the display label admins can rename.
model ExpenseCategoryConfig {
  id        String   @id @default(cuid())
  name      String   @unique
  code      String   @unique
  isActive  Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  expenses Expense[]

  @@index([isActive, sortOrder])
}

model Expense {
  id          String                @id @default(cuid())
  salesmanId  String
  salesman    Salesman              @relation(fields: [salesmanId], references: [id])
  categoryId  String
  category    ExpenseCategoryConfig @relation(fields: [categoryId], references: [id])
  amount      Decimal               @db.Decimal(10, 2)
  gstAmount   Decimal?              @db.Decimal(10, 2)
  expenseDate DateTime
  merchant    String? // vendor name
  billNumber  String?
  paymentMode PaymentMode           @default(CASH)
  description String?
  remarks     String?
  status      ExpenseStatus         @default(PENDING)

  billImageUrl  String?
  ocrRawText    String?
  ocrConfidence Decimal? @db.Decimal(5, 2)
  ocrProvider   String?

  // GPS location captured only with the salesman's explicit browser/device
  // permission at submission time — never collected silently (§10).
  latitude           Decimal?  @db.Decimal(9, 6)
  longitude          Decimal?  @db.Decimal(9, 6)
  locationAccuracy   Decimal?  @db.Decimal(8, 2)
  locationCapturedAt DateTime?

  // Duplicate-bill protection (§16) — flagged automatically at submission,
  // cleared only by an explicit admin decision on review.
  isPossibleDuplicate  Boolean   @default(false)
  duplicateOfExpenseId String?
  duplicateOf          Expense?  @relation("ExpenseDuplicate", fields: [duplicateOfExpenseId], references: [id])
  duplicateFlags       Expense[] @relation("ExpenseDuplicate")

  submittedAt    DateTime  @default(now())
  editedAt       DateTime?
  editedByUserId String?

  reviewedByUserId String?
  reviewedBy       User?     @relation("ExpenseReviewedBy", fields: [reviewedByUserId], references: [id])
  reviewedAt       DateTime?
  adminRemarks     String? // reason for REJECTED or CORRECTION_REQUESTED
  reimbursedAt     DateTime?

  // §22 accounting rule: an approved/reimbursed record is locked against
  // further edits. An authorized admin can explicitly reopen it, and that
  // action itself is recorded here plus in the immutable AuditLog.
  isLocked         Boolean   @default(false)
  reopenedByUserId String?
  reopenedAt       DateTime?

  settlementId String?
  settlement   ExpenseSettlement? @relation(fields: [settlementId], references: [id])

  @@index([salesmanId])
  @@index([status])
  @@index([expenseDate])
  @@index([categoryId])
  @@index([billNumber])
  @@index([settlementId])
}

/// A cash advance handed to a salesman for field travel (§12/§13). Advances
/// are consumed by an ExpenseSettlement once the period is closed.
model ExpenseAdvance {
  id            String             @id @default(cuid())
  salesmanId    String
  salesman      Salesman           @relation(fields: [salesmanId], references: [id])
  amount        Decimal            @db.Decimal(12, 2)
  purpose       String?
  givenAt       DateTime           @default(now())
  givenByUserId String
  givenBy       User               @relation("AdvanceGivenBy", fields: [givenByUserId], references: [id])
  settlementId  String?
  settlement    ExpenseSettlement? @relation(fields: [settlementId], references: [id])
  createdAt     DateTime           @default(now())

  @@index([salesmanId])
  @@index([settlementId])
}

/// Month-end (or any custom period) reconciliation of advance vs. approved
/// expenses for one salesman (§13). Closing a settlement locks every
/// approved expense and advance it covers against further edits.
model ExpenseSettlement {
  id               String              @id @default(cuid())
  salesmanId       String
  salesman         Salesman            @relation(fields: [salesmanId], references: [id])
  periodStart      DateTime            @db.Date
  periodEnd        DateTime            @db.Date
  openingAdvance   Decimal             @db.Decimal(12, 2)
  newAdvance       Decimal             @db.Decimal(12, 2)
  approvedExpenses Decimal             @db.Decimal(12, 2)
  closingBalance   Decimal             @db.Decimal(12, 2)
  direction        SettlementDirection
  notes            String?
  settledByUserId  String
  settledBy        User                @relation("SettlementSettledBy", fields: [settledByUserId], references: [id])
  settledAt        DateTime            @default(now())

  advances ExpenseAdvance[]
  expenses Expense[]

  @@unique([salesmanId, periodStart, periodEnd])
  @@index([salesmanId])
}

// ---------------------------------------------------------------------------
// TOUR PLANNING & VISITS
// ---------------------------------------------------------------------------

model TourSchedule {
  id              String   @id @default(cuid())
  salesmanId      String
  salesman        Salesman @relation(fields: [salesmanId], references: [id])
  scheduleDate    DateTime @db.Date
  createdByUserId String
  createdBy       User     @relation("TourCreatedBy", fields: [createdByUserId], references: [id])
  createdAt       DateTime @default(now())

  stops TourStop[]

  @@unique([salesmanId, scheduleDate])
}

model TourStop {
  id             String       @id @default(cuid())
  tourScheduleId String
  tourSchedule   TourSchedule @relation(fields: [tourScheduleId], references: [id], onDelete: Cascade)
  customerId     String
  customer       Customer     @relation(fields: [customerId], references: [id])
  sequence       Int
  plannedTime    String? // "09:00" free-text slot, kept simple by design
  objective      String?
  status         VisitStatus  @default(PLANNED)

  visit Visit?

  @@index([tourScheduleId])
}

/// A single field visit. Location fields are populated only when the
/// salesman has granted browser/device location permission — never
/// collected silently. See docs/SECURITY.md "Location & consent".
model Visit {
  id         String    @id @default(cuid())
  salesmanId String
  salesman   Salesman  @relation(fields: [salesmanId], references: [id])
  customerId String
  customer   Customer  @relation(fields: [customerId], references: [id])
  tourStopId String?   @unique
  tourStop   TourStop? @relation(fields: [tourStopId], references: [id])

  status          VisitStatus @default(IN_PROGRESS)
  startedAt       DateTime    @default(now())
  endedAt         DateTime?
  startLat        Decimal?    @db.Decimal(9, 6)
  startLng        Decimal?    @db.Decimal(9, 6)
  endLat          Decimal?    @db.Decimal(9, 6)
  endLng          Decimal?    @db.Decimal(9, 6)
  locationConsent Boolean     @default(false)
  notes           String?

  orderId   String? @unique
  order     Order?  @relation(fields: [orderId], references: [id])
  paymentId String?

  @@index([salesmanId])
  @@index([customerId])
}

// ---------------------------------------------------------------------------
// NOTIFICATIONS / AUDIT / SETTINGS
// ---------------------------------------------------------------------------

model Notification {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String
  title     String
  body      String
  linkUrl   String?
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId, isRead])
}

/// Immutable trail of who-did-what-when, required for pharmaceutical
/// distribution accountability (price changes, approvals, cancellations).
model AuditLog {
  id           String   @id @default(cuid())
  actorUserId  String?
  actor        User?    @relation("AuditActor", fields: [actorUserId], references: [id])
  action       String
  entityType   String
  entityId     String?
  metadataJson Json?
  ipAddress    String?
  createdAt    DateTime @default(now())

  @@index([entityType, entityId])
  @@index([actorUserId])
  @@index([createdAt])
}

/// Key/value business configuration editable from the admin Settings screen
/// (branding, tax defaults, OTP policy, expense categories, etc.) so
/// operational changes never require a code deploy.
model Setting {
  id              String   @id @default(cuid())
  key             String   @unique
  valueJson       Json
  updatedByUserId String?
  updatedBy       User?    @relation("SettingUpdatedBy", fields: [updatedByUserId], references: [id])
  updatedAt       DateTime @updatedAt
}
